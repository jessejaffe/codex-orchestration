{
  "description": "Inject the fast chat-local routing contract once per user prompt.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/prompt-router-hook.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
