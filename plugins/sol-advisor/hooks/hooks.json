{
  "description": "Prevent routed Sol Advisor tasks from silently omitting their final receipt.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/receipt-stop-hook.py\"",
            "timeout": 30,
            "statusMessage": "Checking Sol Advisor receipt"
          }
        ]
      }
    ]
  }
}
